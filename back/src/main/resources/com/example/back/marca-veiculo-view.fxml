<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.back.MarcaVeiculoController">
   <children>
      <Button layoutX="29.0" layoutY="26.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
      <Label layoutX="190.0" layoutY="30.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Cadastro de Marca de Veículo" />

      <Label layoutX="150.0" layoutY="152.0" text="Nome:" />
      <TextField fx:id="txtNome" layoutX="230.0" layoutY="148.0" prefWidth="220.0" promptText="Ex.: Marcopolo, Volvo" />
      <Label layoutX="150.0" layoutY="190.0" text="Tipo:" />
      <TextField fx:id="txtTipo" layoutX="230.0" layoutY="186.0" prefWidth="220.0" promptText="Ex.: Ônibus ou Caminhão" />
      <Label layoutX="150.0" layoutY="230.0" text="Ano:" />
      <TextField fx:id="txtAno" layoutX="230.0" layoutY="226.0" prefWidth="220.0" promptText="Ex.: 2024" />

      <Button layoutX="528.0" layoutY="351.0" mnemonicParsing="false" onAction="#salvarMarcaVeiculo" text="Salvar" />
   </children>
</AnchorPane>